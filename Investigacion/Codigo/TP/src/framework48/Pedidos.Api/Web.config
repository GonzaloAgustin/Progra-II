<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="Pedidos" connectionString="Server=(localdb)\MSSQLLocalDB;Database=ComercialPedidosFw;Integrated Security=True;MultipleActiveResultSets=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Url" value="http://localhost:5013/" />
    <add key="Servicios:Productos" value="http://localhost:5011/" />
    <add key="Servicios:Inventario" value="http://localhost:5012/" />
    <add key="Servicios:TimeoutSegundos" value="5" />
    <add key="Reconciliacion:Habilitada" value="true" />
    <add key="Reconciliacion:IntervaloSegundos" value="30" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
