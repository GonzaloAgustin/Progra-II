<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="Inventario" connectionString="Server=(localdb)\MSSQLLocalDB;Database=ComercialInventarioFw;Integrated Security=True;MultipleActiveResultSets=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Url" value="http://localhost:5012/" />
    <add key="Servicios:Productos" value="http://localhost:5011/" />
    <add key="Servicios:TimeoutSegundos" value="5" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
